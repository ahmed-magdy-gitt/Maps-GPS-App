<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Shadow/Glow Layer -->
    <!-- نستخدم ظل لونه أصفر/ذهبي فاتح لجعل البطاقة تتوهج -->
    <item>
        <shape android:shape="rectangle">
            <!-- لون التوهج المقترح (الأصفر الذهبي) -->
            <solid android:color="#FFD700" />
            <corners android:radius="15dp" />
            <!-- لجعل الظل المنتشر نستخدم خاصية التغبيش (Blur) في CardView نفسها -->
        </shape>
    </item>

    <!-- 2. Main Card Color Layer -->
    <!-- هذا هو اللون الفعلي للبطاقة ليغطي التوهج في المنتصف، مع إبقاء الظل/التوهج في الأطراف -->
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <!-- استخدمنا لون البطاقة الأصلي الذي أرسلته أنت: #92663E -->
            <solid android:color="#92663E" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
