<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background"
    xmlns:tools="http://schemas.android.com/tools"
    android:focusableInTouchMode="true">
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        tools:context=".DistanceBtnActivity"
        android:padding="16dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/distance_btn_two_locations"
            android:layout_gravity="center"
            android:layout_margin="64dp"
            android:textColor="@color/common_google_signin_btn_text_dark_pressed"
            android:textSize="21sp"
            android:textStyle="bold"/>
        <AutoCompleteTextView
            android:id="@+id/location1EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اختر أو ابحث عن الموقع الأول"
            android:inputType="text"
            android:textColorHint="@color/black"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:padding="10dp"
            android:layout_marginBottom="32dp"
            android:drawablePadding="10dp" />


        <AutoCompleteTextView
            android:id="@+id/location2EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اختر أو ابحث عن الموقع الثاني"
            android:inputType="text"
            android:textColorHint="@color/black"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:padding="10dp"
            android:drawablePadding="10dp"
            android:layout_marginTop="16dp" />


        <Button
            android:id="@+id/calc_dis_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="#D95D5D"
            android:textColor="@android:color/white"
            android:layout_marginTop="@dimen/margin_16dp"
            android:text="احسب المسافة"
            android:textSize="18dp"/>

        <TextView
            android:id="@+id/distanceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="المسافة بين الموقعين:"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:layout_marginTop="64dp" />
    </LinearLayout>
</ScrollView>

