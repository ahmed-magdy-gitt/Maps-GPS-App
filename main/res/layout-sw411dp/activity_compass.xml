<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/currentLocationLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_4dp"
        android:paddingEnd="@dimen/padding_4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/targetLocationLayout"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_location_txt"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_20sp"
            android:layout_marginTop="@dimen/margin_18dp"/>

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="@dimen/hieght_30dp"
            android:orientation="horizontal"
            android:background="@drawable/linear_background"
            android:layout_marginTop="@dimen/margin_8dp">

            <ImageView
                android:layout_width="@dimen/width_height_20dp"
                android:layout_height="@dimen/width_height_20dp"
                android:src="@drawable/latandlong"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/margin_2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Long_tx"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <View
                android:layout_width="1dp"
                android:layout_height="15dp"
                android:background="#D72525"
                android:layout_marginStart="@dimen/magrin_4dp"/>

            <TextView
                android:id="@+id/current_long"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/margin_8dp"
                tools:text="31.10688"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="@dimen/hieght_30dp"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/margin_8dp"
            android:background="@drawable/linear_background"
            >

            <ImageView
                android:layout_width="@dimen/width_height_20dp"
                android:layout_height="@dimen/width_height_20dp"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/margin_2dp"
                android:src="@drawable/latandlong" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lat_tx"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <View
                android:layout_width="1dp"
                android:layout_height="15dp"
                android:background="#D72525"
                android:layout_marginStart="@dimen/magrin_4dp" />

            <TextView
                android:id="@+id/current_lat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/margin_8dp"
                tools:text="29.04433"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/targetLocationLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="start"
        android:paddingStart="@dimen/padding_8dp"
        android:paddingEnd="@dimen/padding_8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/currentLocationLayout"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/targetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الوجهة المحددة"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_20sp"
            android:layout_marginTop="@dimen/margin_18dp"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="@dimen/hieght_30dp"
            android:orientation="horizontal"
            android:background="@drawable/linear_background"
            android:layout_marginTop="@dimen/margin_8dp">

            <ImageView
                android:layout_width="@dimen/width_height_20dp"
                android:layout_height="@dimen/width_height_20dp"
                android:src="@drawable/latandlong"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/margin_2dp" />

            <TextView
                android:text="@string/target_long"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <View
                android:layout_width="1dp"
                android:layout_height="15dp"
                android:background="#D72525"
                android:layout_marginStart="4dp"/>

            <TextView
                android:id="@+id/target_long"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                tools:text="31.10680"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="@dimen/hieght_30dp"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/margin_8dp"
            android:background="@drawable/linear_background"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/width_height_20dp"
                android:layout_height="@dimen/width_height_20dp"
                android:src="@drawable/latandlong"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/margin_2dp" />

            <TextView
                android:text="@string/target_lat"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <View
                android:layout_width="1dp"
                android:layout_height="15dp"
                android:background="#D72525"
                android:layout_marginStart="4dp"/>

            <TextView
                android:id="@+id/target_lat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginStart="@dimen/margin_8dp"
                tools:text="29.04430"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:id="@+id/clearTargetButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مسح الهدف"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        android:backgroundTint="#D95D5D"
        android:textColor="@android:color/white"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/targetLocationLayout" />


    <TextView
        android:id="@+id/qiblaDirectionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="@dimen/text_size_22sp"
        tools:text="111111111"
        android:shadowDx="15"
        android:shadowRadius="15"
        android:shadowDy="15"
        android:shadowColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/currentLocationLayout"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_130dp"/>

    <TextView
        android:id="@+id/locationText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="@dimen/text_size_36sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/qiblaDirectionText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_8dp"/>

    <TextView
        android:id="@+id/directionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="شمال"
        android:textSize="@dimen/text_size_22sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_red_dark"
        app:layout_constraintTop_toBottomOf="@id/locationText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_8dp"/>

    <RelativeLayout
        android:id="@+id/compassContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/directionText"
        app:layout_constraintBottom_toTopOf="@+id/bottomInfoLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/compassImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/menna"
            android:scaleType="fitCenter" />

        <View
            android:id="@+id/compass_middlePoint"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerInParent="true" />

        <ImageView
            android:id="@+id/arrowImage"
            android:layout_width="@dimen/arrow_width"
            android:layout_height="@dimen/arrow_height"
            android:layout_centerInParent="true"
            android:layout_alignBottom="@id/compass_middlePoint"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/target_dircetion"
            android:visibility="visible" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/bottomInfoLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@+id/newButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/margin_18dp"
        android:layout_marginEnd="@dimen/margin_18dp"
        android:layout_marginBottom="@dimen/margin_8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_40dp"
                android:background="@drawable/linear_background"
                android:orientation="horizontal"
                android:padding="2dp"
                android:layout_marginBottom="@dimen/magrin_4dp">

                <TextView
                    android:layout_width="@dimen/width_110dp"
                    android:layout_height="wrap_content"
                    android:text="@string/horizontal_distance"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_18sp"

                    android:textStyle="bold"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="15dp"
                    android:background="#D72525"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/magrin_4dp"/>

                <TextView
                    android:id="@+id/horizontal_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00.000"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginStart="2dp"
                    android:textSize="14dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_40dp"
                android:background="@drawable/linear_background"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:layout_width="@dimen/width_110dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hieght"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_18sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="15dp"
                    android:background="#D72525"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/magrin_4dp"/>

                <TextView
                    android:id="@+id/altitudeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00000"
                    android:textColor="@color/white"
                    android:layout_marginStart="2dp"
                    android:textSize="@dimen/text_size_18sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/speedText"
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="wrap_content"
            tools:text="55555"
            android:gravity="end"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_36sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <Button
        android:id="@+id/newButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="القائمة"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#8A2929"  android:layout_marginStart="@dimen/margin_24dp"
        android:layout_marginEnd="@dimen/margin_24dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>